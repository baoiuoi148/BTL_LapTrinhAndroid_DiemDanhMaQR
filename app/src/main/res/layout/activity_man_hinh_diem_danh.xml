<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    tools:context=".ManHinhDiemDanh">

    <!-- Header xanh: logo + FitHou + 3 icon -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutHeader"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/primary_blue"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_header_logo_rect"
            android:contentDescription="Logo FitHou"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fithou_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewTenApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="FitHou"
            android:textColor="@color/white"
            android:textSize="32sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageViewLogo"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewTaiKhoan"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="18dp"
            android:clickable="true"
            android:contentDescription="Tài khoản"
            android:focusable="true"
            android:src="@drawable/ic_user_header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewCheDoToi"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="28dp"
            android:clickable="true"
            android:contentDescription="Chế độ tối"
            android:focusable="true"
            android:src="@drawable/ic_moon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imageViewTaiKhoan"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewChat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="28dp"
            android:clickable="true"
            android:contentDescription="Tin nhắn"
            android:focusable="true"
            android:src="@drawable/ic_chat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imageViewCheDoToi"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Thanh tiêu đề trắng: "Quét mã QR điểm danh" + đèn flash + lịch sử -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutTieuDe"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constraintLayoutHeader">

        <TextView
            android:id="@+id/textViewTieuDe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Quét mã QR điểm danh"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewLichSu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="18dp"
            android:clickable="true"
            android:contentDescription="Lịch sử điểm danh"
            android:focusable="true"
            android:src="@drawable/ic_history"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewFlash"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="30dp"
            android:clickable="true"
            android:contentDescription="Bật đèn flash"
            android:focusable="true"
            android:src="@drawable/ic_flash"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imageViewLichSu"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Vùng quét mã QR -->

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcodeScannerViewQuetMa"
        app:zxing_framing_rect_width="180dp"
        app:zxing_framing_rect_height="180dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayoutTieuDe"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayoutBottomNav" />

    <!-- Kết quả điểm danh hiển thị trên vùng camera, giữa tiêu đề và thanh điều hướng. -->
    <ScrollView
        android:id="@+id/scrollViewKetQuaDiemDanh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/scan_background"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/constraintLayoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constraintLayoutTieuDe">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_khung_thanh_cong"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp">

                <ImageView
                    android:id="@+id/imageViewKetQuaDiemDanh"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_success_big" />

                <TextView
                    android:id="@+id/textViewTieuDeKetQua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Điểm danh thành công!" />

                <TextView
                    android:id="@+id/textViewMonHocKetQua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    tools:text="Môn học: Chủ nghĩa xã hội" />

                <TextView
                    android:id="@+id/textViewGiangVienKetQua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    tools:text="Giảng viên: TS. Nguyễn Thị Luận" />

                <TextView
                    android:id="@+id/textViewNhanGioDiemDanh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Điểm danh thành công lúc:"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/textViewGioDiemDanh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/success_blue"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="07:40:25" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonVeTrangChuKetQua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_thanh_cong"
                    android:drawableStart="@drawable/ic_nav_home"
                    android:drawablePadding="10dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="18dp"
                    android:text="Về trang chủ"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Thanh điều hướng dưới -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/card_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/linearLayoutNavTrangChu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/linearLayoutNavWebsite"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/imageViewNavTrangChu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Trang chủ"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/textViewNavTrangChu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Trang chủ"
                android:textColor="@color/primary_blue_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutNavWebsite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/linearLayoutNavQr"
            app:layout_constraintStart_toEndOf="@id/linearLayoutNavTrangChu">

            <ImageView
                android:id="@+id/imageViewNavWebsite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Website"
                android:src="@drawable/ic_nav_website" />

            <TextView
                android:id="@+id/textViewNavWebsite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Website"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutNavQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/linearLayoutNavCamNang"
            app:layout_constraintStart_toEndOf="@id/linearLayoutNavWebsite">

            <ImageView
                android:id="@+id/imageViewNavQr"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Quét mọi QR"
                android:src="@drawable/ic_nav_qr" />

            <TextView
                android:id="@+id/textViewNavQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Quét mọi QR"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutNavCamNang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/linearLayoutNavHoSo"
            app:layout_constraintStart_toEndOf="@id/linearLayoutNavQr">

            <ImageView
                android:id="@+id/imageViewNavCamNang"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Cẩm nang"
                android:src="@drawable/ic_nav_book" />

            <TextView
                android:id="@+id/textViewNavCamNang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cẩm nang"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutNavHoSo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/linearLayoutNavCamNang">

            <ImageView
                android:id="@+id/imageViewNavHoSo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Hồ sơ"
                android:src="@drawable/ic_nav_profile" />

            <TextView
                android:id="@+id/textViewNavHoSo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hồ sơ"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>