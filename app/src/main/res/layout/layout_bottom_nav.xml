<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/card_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/linearLayoutNavTrangChu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/linearLayoutNavWebsite"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imageViewNavTrangChu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Trang chủ"
            android:src="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/textViewNavTrangChu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Trang chủ"
            android:textColor="@color/primary_blue_dark"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutNavWebsite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/linearLayoutNavQr"
        app:layout_constraintStart_toEndOf="@id/linearLayoutNavTrangChu">

        <ImageView
            android:id="@+id/imageViewNavWebsite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Website"
            android:src="@drawable/ic_nav_website" />

        <TextView
            android:id="@+id/textViewNavWebsite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Website"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutNavQr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/linearLayoutNavCamNang"
        app:layout_constraintStart_toEndOf="@id/linearLayoutNavWebsite">

        <ImageView
            android:id="@+id/imageViewNavQr"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Quét mọi QR"
            android:src="@drawable/ic_nav_qr" />

        <TextView
            android:id="@+id/textViewNavQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Quét mọi QR"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutNavCamNang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/linearLayoutNavHoSo"
        app:layout_constraintStart_toEndOf="@id/linearLayoutNavQr">

        <ImageView
            android:id="@+id/imageViewNavCamNang"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Cẩm nang"
            android:src="@drawable/ic_nav_book" />

        <TextView
            android:id="@+id/textViewNavCamNang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cẩm nang"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutNavHoSo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/linearLayoutNavCamNang">

        <ImageView
            android:id="@+id/imageViewNavHoSo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Hồ sơ"
            android:src="@drawable/ic_nav_profile" />

        <TextView
            android:id="@+id/textViewNavHoSo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hồ sơ"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>